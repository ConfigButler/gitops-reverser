apiVersion: configbutler.ai/v1alpha3
kind: GitBranch
metadata:
  name: {{ .GitBranchName }}
  namespace: {{ .Namespace }}
  labels:
    e2e.configbutler.ai/git-provider: {{ .ProviderName }}
spec:
  gitProviderRef:
    name: {{ .ProviderName }}
  branch: {{ .Branch }}
  allowedGitTargets:
    - consumerNamespaces: {from: Same}
{{- if .ParentBranch }}
  parentBranch: {{ .ParentBranch }}
{{- end }}
---
apiVersion: configbutler.ai/v1alpha3
kind: GitTarget
metadata:
  name: {{ .Name }}
  namespace: {{ .Namespace }}
spec:
  gitBranchRef:
    name: {{ .GitBranchName }}
{{ .KubeProviderRef }}
  path: {{ .Path }}
{{- if or .CommitWindow .LiveTemplate .ReconcileTemplate }}
  commit:
{{- end }}
{{- if .CommitWindow }}
    window:
      idleTimeout: "{{ .CommitWindow }}"
      maxDuration: "{{ .CommitMaxDuration }}"
{{- end }}
{{- if or .LiveTemplate .ReconcileTemplate }}
    message:
{{- if .LiveTemplate }}
      liveTemplate: "{{ .LiveTemplate }}"
{{- end }}
{{- if .ReconcileTemplate }}
      reconcileTemplate: "{{ .ReconcileTemplate }}"
{{- end }}
{{- end }}
  encryption:
    provider: sops
    age:
      enabled: true
      recipients:
        extractFromSecret: true
{{- if .GenerateWhenMissing }}
        generateWhenMissing: true
{{- end }}
    secretRef:
      name: {{ .EncryptionSecretName }}
