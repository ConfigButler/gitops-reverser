apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{ .Name }}
  namespace: {{ .ArgoNamespace }}
spec:
  project: default
  source:
    repoURL: {{ .RepoURL }}
    targetRevision: {{ .Branch }}
    path: {{ .Path }}
{{- if not .Kustomize }}
    directory:
      # gitops-reverser mirrors into <path>/<namespace>/<group>/<plural>/<name>.yaml,
      # so Argo must walk subdirectories to see anything at all.
      recurse: true
{{- end }}
  destination:
    server: https://kubernetes.default.svc
    namespace: {{ .DestinationNamespace }}
  syncPolicy:
    automated:
{{- if .Automated }}
      # Automated sync ON: no `enabled`, which Argo CD reads as on.
      prune: true
{{- else }}
      # The standard: automated sync off, prune kept for the syncs GitOps Reverser starts.
      enabled: false
      prune: true
{{- end }}
