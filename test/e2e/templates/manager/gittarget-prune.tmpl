apiVersion: configbutler.ai/v1alpha3
kind: GitTarget
metadata:
  name: {{ .Name }}
  namespace: {{ .Namespace }}
spec:
  providerRef:
    kind: GitProvider
    name: {{ .ProviderName }}
  branch: {{ .Branch }}
  path: {{ .Path }}
  commit:
    window: "0s"
{{- if .PruneMode }}
  prune:
    mode: {{ .PruneMode }}
{{- end }}
