apiVersion: configbutler.ai/v1alpha3
kind: GitBranch
metadata:
  name: {{ .GitBranchName }}
  namespace: {{ .Namespace }}
  labels:
    e2e.configbutler.ai/git-provider: {{ .ProviderName }}
spec:
  gitProviderRef:
    name: {{ .ProviderName }}
  branch: {{ .Branch }}
---
apiVersion: configbutler.ai/v1alpha3
kind: GitTarget
metadata:
  name: {{ .Name }}
  namespace: {{ .Namespace }}
spec:
  gitBranchRef:
    name: {{ .GitBranchName }}
  path: {{ .Path }}
  commit:
    window:
      idleTimeout: "0s"
{{- if .PruneMode }}
  prune:
    mode: {{ .PruneMode }}
{{- end }}
